# Windows-MCP 配置文件示例
# 复制为 %USERPROFILE%\.windows-mcp\config.toml 后修改，
# 或直接运行 windows-mcp.exe / setup 向导自动生成。

[server]
# 传输协议: "stdio" | "sse" | "streamable-http"
transport = "sse"
# 绑定地址。
#   0.0.0.0  —— 监听所有网卡（推荐：双网卡机器上两个网络都能连）
#   127.0.0.1 —— 仅本机
#   指定某个 IP（如 192.168.1.10）—— 只监听该网卡
host = "0.0.0.0"
port = 8000
# 认证密钥。绑定非回环地址时必填（向导会自动生成）。
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
auth_key = "请改成随机密钥"
# 如需允许无认证的内网访问（不推荐），取消注释:
# allow_insecure_remote = true

[security]
# 只允许这些客户端 IP / 网段访问（双网卡场景可各写一条）:
# ip_allowlist = ["192.168.1.0/24", "192.168.2.0/24"]
# cors_origins = ["https://my-client.example.com"]

[tools]
exclude = ["PowerShell"]

[local]
# 额外暴露 127.0.0.1 本机专用端口（不需要认证），由 EXE 的 serve-all 使用
enabled = false
port = 8001
