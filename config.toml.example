# Windows-MCP 配置文件示例
# 复制为 ~/.windows-mcp/config.toml 后修改
# 或运行 windows-mcp.exe setup 交互生成

[server]
# 传输协议: "stdio" | "sse" | "streamable-http"
transport = "sse"
# 绑定地址（0.0.0.0 对内网开放，127.0.0.1 仅本机）
host = "0.0.0.0"
port = 8000
# auth_key = "your_secret"

[security]
# ip_allowlist = ["192.168.1.0/24"]
# cors_origins = ["https://my-client.example.com"]

[tools]
exclude = ["PowerShell"]

[local]
# 额外暴露 127.0.0.1 本机专用端口（不需要认证）
enabled = true
port = 8001
